---
// Bir `Alan` değerini yazar; yoksa yer tutucu, doğrulanmamışsa işaret gösterir.
import Bekliyor from './Bekliyor.astro';
import type { Alan } from '../data/isletme';
interface Props { alan: Alan }
const { alan } = Astro.props;
---
{alan.deger === null
  ? <Bekliyor ne={alan.bekleyen} />
  : <>{alan.deger}{!alan.dogrulandi && <> <Bekliyor ne={`${alan.bekleyen} doğrulanacak`} /></>}</>}
