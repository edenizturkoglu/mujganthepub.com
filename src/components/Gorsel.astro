---
// Fotoğraf: boyut JSON'daki w/h'den ya da gorseller.json'dan (CLS olmasın). `cms` verilirse tıkla-düzenle ile değiştirilebilir.
import boyutlar from '../data/gorseller.json';
import type { Gorsel } from '../lib/icerik';
interface Props { g: Gorsel; cms?: string; oncelik?: boolean }
const { g, cms, oncelik = false } = Astro.props;
const b = g.w && g.h ? [g.w, g.h] : (boyutlar as Record<string, number[]>)[g.src];
---
<img src={g.src} alt={g.alt} width={b?.[0]} height={b?.[1]} decoding="async"
  loading={oncelik ? undefined : 'lazy'} fetchpriority={oncelik ? 'high' : undefined}
  style={g.konum ? `object-position:${g.konum}` : undefined}
  data-cms={cms} data-cms-tur={cms ? 'image' : undefined} />
