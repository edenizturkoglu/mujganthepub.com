---
import '../styles/global.css';
import { isletme, rezervasyon } from '../data/isletme';
import { hafta } from '../data/program';
import { seo as seoTum, ozelSayfalar, type Seo } from '../lib/icerik';
import Logo from '../components/Logo.astro';
import Ikon from '../components/Ikon.astro';

interface Props {
  /** site kökünden yol, sonu "/" ile: '/', '/menu/', '/etkinlikler/', '/<slug>/' */
  yol: string;
  sayfa: 'ana' | 'menu' | 'etkinlikler' | 'diger';
  /** Verilmezse src/icerik/seo.json'daki kayıt kullanılır */
  seo?: Seo;
  sema?: object[];
  sayfaOlayi?: string;
  /** İlk ekrandaki kapak görseli (önceden yüklenir) */
  onYukle?: string;
}
const { yol, sayfa, sema = [], sayfaOlayi } = Astro.props;
const s: Seo = Astro.props.seo ?? seoTum[yol] ?? seoTum['/'];
const baslik = s.baslik;
const aciklama = s.aciklama;
const kapakGorseli = s.kapak || '/img/hgp-6015.jpg';
const indeksle = s.indeksle !== false;
const kanonik = `${isletme.site}${yol}`;
const rez = rezervasyon();
const haritaUrl = isletme.haritaLinki;
const ekMenu = ozelSayfalar.filter((p) => p.menudeGoster);
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{baslik}</title>
    <meta name="description" content={aciklama} />
    <link rel="canonical" href={kanonik} />
    <meta name="robots" content={isletme.yayinda && indeksle ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={isletme.tamAd} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={baslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:url" content={kanonik} />
    <meta property="og:image" content={`${isletme.site}${kapakGorseli}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="geo.region" content="TR-06" />
    <meta name="geo.placename" content="Çayyolu, Çankaya, Ankara" />
    <meta name="theme-color" content="#0A1A14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/young-serif-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" as="image" href={Astro.props.onYukle ?? kapakGorseli} fetchpriority="high" />
    {sema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body data-sayfa-olayi={sayfaOlayi}>
    <a class="atla" href="#icerik">İçeriğe geç</a>
    {!isletme.yayinda && <div class="draft-bar">Taslak · [DOLDURULACAK] alanlar işletmeden gelecek</div>}
    <header class="top" id="top">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${isletme.tamAd} ana sayfa`}><Logo on="hd" /></a>
        <nav class="nav" aria-label="Ana menü">
          <a href="/menu/" aria-current={sayfa === 'menu' ? 'page' : undefined} data-olay="menu_goruntule">Menü</a>
          <a href="/etkinlikler/" aria-current={sayfa === 'etkinlikler' ? 'page' : undefined}>Etkinlikler</a>
          {ekMenu.map((p) => <a href={`/${p.slug}/`} aria-current={yol === `/${p.slug}/` ? 'page' : undefined}>{p.baslik}</a>)}
          <a href="/#paket">Paket servis</a>
          <a href="/#ulasim">Ulaşım</a>
        </nav>
        <a class="btn btn-gold" href={rez.url} target="_blank" rel="noopener" data-olay="rezervasyon_tikla" data-platform={rez.kanal}>Rezervasyon</a>
      </div>
    </header>

    <main id="icerik"><slot /></main>

    <footer class="foot">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${isletme.tamAd} ana sayfa`}><Logo on="ft" /></a>
        <nav aria-label="Alt menü">
          <a href="/menu/">Menü</a>
          <a href="/etkinlikler/">Etkinlikler</a>
          {ekMenu.map((p) => <a href={`/${p.slug}/`}>{p.baslik}</a>)}
          <a href="/#paket">Paket servis</a>
          <a href="/#ulasim">Ulaşım</a>
          <a href={isletme.instagram.url} target="_blank" rel="noopener" data-olay="instagram_tikla">Instagram</a>
        </nav>
        <address>
          <b>{isletme.tamAd}</b><br />
          {isletme.adres.sokak}, {isletme.adres.mekan}<br />
          {isletme.adres.postaKodu} {isletme.adres.ilce} / {isletme.adres.il} · Her gün {isletme.saatler.acik}
          {isletme.telefon && <><br /><a href={`tel:${isletme.telefon.replace(/\s/g, '')}`} data-olay="telefon_tikla">{isletme.telefon}</a></>}
        </address>
      </div>
    </footer>

    <nav class="actionbar" aria-label="Hızlı erişim">
      <a href="/menu/" aria-current={sayfa === 'menu' ? 'page' : undefined} data-olay="menu_goruntule"><Ikon ad="menu" />Menü</a>
      <a href="/etkinlikler/" aria-current={sayfa === 'etkinlikler' ? 'page' : undefined}><Ikon ad="cal" />Etkinlikler</a>
      <a href={haritaUrl} target="_blank" rel="noopener" data-olay="yol_tarifi_tikla"><Ikon ad="pin" />Yol tarifi</a>
      <a class="ab-cta" href={rez.url} target="_blank" rel="noopener" data-olay="rezervasyon_tikla" data-platform={rez.kanal}><Ikon ad="chat" />Rezervasyon</a>
    </nav>

    <script is:inline define:vars={{ hafta }}>
      (function () {
        var top = document.getElementById('top');
        function kaydir() { top.classList.toggle('solid', window.scrollY > 40); }
        kaydir(); window.addEventListener('scroll', kaydir, { passive: true });
        if (document.querySelector('.draft-bar')) document.body.classList.add('has-draft');

        // Bugünün programı (getDay: 0 = pazar)
        var gun = new Date().getDay();
        var haftaIci = gun >= 1 && gun <= 5;
        document.querySelectorAll('[data-dow="' + gun + '"]').forEach(function (el) { el.classList.add('is-today'); });
        if (haftaIci) document.querySelectorAll('[data-dow="wk"]').forEach(function (el) { el.classList.add('is-today'); });
        var t = document.getElementById('tonight');
        if (t) {
          var d = hafta[gun];
          var yaz = function (k, v) { t.querySelector('[data-t=' + k + ']').textContent = v; };
          yaz('day', d.ad);
          if (d.baslik) { yaz('title', d.baslik); yaz('time', d.saat || ''); yaz('text', d.kisa || ''); }
          else if (haftaIci) { yaz('title', 'Social Hour'); yaz('time', '18.00’e kadar'); yaz('text', 'Tüm içeceklerde %20 indirim.'); }
          else { yaz('title', 'Pazar keyfi'); yaz('time', ''); yaz('text', 'Öğle ve akşam yemeği, gün boyu.'); }
        }
        // Tarihi geçen etkinlikleri gizle
        var bugun = new Date(); bugun.setHours(0, 0, 0, 0);
        var kalan = 0;
        document.querySelectorAll('[data-date]').forEach(function (el) {
          var dd = new Date(el.getAttribute('data-date') + 'T00:00:00');
          if (dd < bugun) el.hidden = true; else kalan++;
        });
        var up = document.getElementById('upcoming');
        if (up && !kalan) up.hidden = true;
      })();
    </script>
    <script>
      // Tıklama ölçümü: ölçüm aracı henüz seçilmedi, olaylar dataLayer'a yazılır.
      // Not: tıklama gerçekleşmiş ziyaret/rezervasyon sayılmaz.
      const w = window as unknown as { dataLayer: object[] };
      w.dataLayer = w.dataLayer || [];
      const gonder = (olay: string, ek: object = {}) => w.dataLayer.push({ event: olay, ...ek });
      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest<HTMLElement>('[data-olay]');
        if (el) gonder(el.dataset.olay!, el.dataset.platform ? { platform: el.dataset.platform } : {});
      });
      const sayfa = document.body.dataset.sayfaOlayi;
      if (sayfa) gonder(sayfa);
    </script>
  </body>
</html>
