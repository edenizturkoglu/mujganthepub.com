---
import Base from '../layouts/Base.astro';
import Gorsel from '../components/Gorsel.astro';
import Ikon from '../components/Ikon.astro';
import RezButon from '../components/RezButon.astro';
import { isletme } from '../data/isletme';
import { geceler, etkinlikler, tarihParcala } from '../data/program';
import { etkinlikIcerik as e, cms, cmsListe } from '../lib/icerik';
import { etkinlikSema, yolSema } from '../lib/sema';

// JSON'daki sıra (CMS yolu için) korunur; görüntüleme tarihe göre sıralı
const tarihli = etkinlikler.map((x) => ({ x, i: e.etkinlikler.indexOf(x) }));
---
<Base yol="/etkinlikler/" sayfa="etkinlikler" onYukle={e.sayfa.gorsel.src} sema={[...etkinlikSema(), yolSema('Etkinlikler', 'etkinlikler/')]}>
  <section class="hero page-hero" aria-labelledby="prog-title">
    <div class="hero-media"><Gorsel g={e.sayfa.gorsel} cms="etkinlikler:sayfa.gorsel" oncelik /></div>
    <div class="wrap">
      <div class="hero-copy">
        <p class="crumbs"><a href="/">{isletme.tamAd}</a> / {e.sayfa.baslik}</p>
        <h1 id="prog-title" {...cms('etkinlikler:sayfa.baslik')}>{e.sayfa.baslik}</h1>
        <p class="lead" {...cms('etkinlikler:sayfa.metin')}>{e.sayfa.metin}</p>
      </div>
    </div>
  </section>

  {tarihli.length > 0 && (
    <section class="sec" id="upcoming" aria-labelledby="up-title">
      <div class="wrap">
        <div class="sec-head"><p class="label" {...cms('etkinlikler:yaklasan.ust')}>{e.yaklasan.ust}</p><h2 id="up-title" {...cms('etkinlikler:yaklasan.baslik')}>{e.yaklasan.baslik}</h2></div>
        <div class="dates" {...cmsListe('etkinlikler:etkinlikler')} data-cms-panel="etkinlikler">
          {tarihli.map(({ x, i }) => {
            const t = tarihParcala(x.tarih);
            return (
              <div class="date-card" data-date={x.tarih} data-cms-oge={i}>
                <div class="d"><b class="num">{t.gun}</b><span>{t.ay}</span></div>
                <div><h3 {...cms(`etkinlikler:etkinlikler.${i}.baslik`)}>{x.baslik}</h3><p>{t.haftaGunu} · {x.saat.replace(':', '.')} · <span {...cms(`etkinlikler:etkinlikler.${i}.tur`)}>{x.tur}</span></p></div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="sec" style="padding-top:0" aria-labelledby="nights-title">
    <div class="wrap">
      <div class="sec-head"><p class="label" {...cms('etkinlikler:ritim.ust')}>{e.ritim.ust}</p><h2 id="nights-title" {...cms('etkinlikler:ritim.baslik')}>{e.ritim.baslik}</h2></div>
      <div class="nights" {...cmsListe('etkinlikler:geceler')}>
        {geceler.map((g, i) => (
          <article class="night" id={g.id} data-dow={g.gun} data-cms-oge={i}>
            <div class="night-poster"><Gorsel g={g.afis} cms={`etkinlikler:geceler.${i}.afis`} /></div>
            <div class="night-body">
              <p class="label" {...cms(`etkinlikler:geceler.${i}.gunAdi`)}>{g.gunAdi}</p>
              <h2 {...cms(`etkinlikler:geceler.${i}.baslik`)}>{g.baslik}</h2>
              {g.saat && <p class="when num" {...cms(`etkinlikler:geceler.${i}.saat`)}>{g.saat}</p>}
              <p {...cms(`etkinlikler:geceler.${i}.metin`)}>{g.metin}</p>
              {g.kampanya && <span class="deal" {...cms(`etkinlikler:geceler.${i}.kampanya`)}>{g.kampanya}</span>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec live-band" aria-labelledby="live-title">
    <div class="wrap live-grid">
      <div class="bar-copy">
        <p class="label" {...cms('etkinlikler:canli.ust')}>{e.canli.ust}</p>
        <h2 id="live-title" {...cms('etkinlikler:canli.baslik', 'html')} set:html={e.canli.baslik} />
        <p {...cms('etkinlikler:canli.metin')}>{e.canli.metin}</p>
        <div class="btns"><RezButon etiket="Masanı ayırt" /></div>
      </div>
      <div class="live-photos">
        {e.canli.gorseller.map((g, i) => <figure><Gorsel g={g} cms={`etkinlikler:canli.gorseller.${i}`} /></figure>)}
      </div>
    </div>
  </section>

  <section class="sec ozel" id="ozel" aria-labelledby="ozel-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="label" {...cms('etkinlikler:ozel.ust')}>{e.ozel.ust}</p>
        <h2 id="ozel-title" {...cms('etkinlikler:ozel.baslik')}>{e.ozel.baslik}</h2>
        <p {...cms('etkinlikler:ozel.metin')}>{e.ozel.metin}</p>
      </div>
      <dl class="olgular" {...cmsListe('etkinlikler:ozel.olgular')}>
        {e.ozel.olgular.map((o, i) => (
          <div data-cms-oge={i}><dt class="num" {...cms(`etkinlikler:ozel.olgular.${i}.deger`)}>{o.deger}</dt><dd {...cms(`etkinlikler:ozel.olgular.${i}.etiket`)}>{o.etiket}</dd></div>
        ))}
      </dl>
      <div class="vesile" {...cmsListe('etkinlikler:ozel.turler')}>
        {e.ozel.turler.map((t, i) => (
          <article class="vesile-kart" id={t.id} data-cms-oge={i}>
            <div class="vesile-img"><Gorsel g={t.gorsel} cms={`etkinlikler:ozel.turler.${i}.gorsel`} /></div>
            <div class="vesile-body">
              <h3 {...cms(`etkinlikler:ozel.turler.${i}.baslik`)}>{t.baslik}</h3>
              <p {...cms(`etkinlikler:ozel.turler.${i}.metin`)}>{t.metin}</p>
              <RezButon sinif="btn-line" etiket="Tarih sor" tur={t.id} mesaj={`Merhaba, ${t.baslik.toLocaleLowerCase('tr-TR')} için Müjgân'da yer ayırtmak istiyorum. Tarih: … Kişi sayısı: …`} />
            </div>
          </article>
        ))}
      </div>
      <div class="panel panel-kraft adimlar">
        <h2 {...cms('etkinlikler:ozel.adimlar.baslik')}>{e.ozel.adimlar.baslik}</h2>
        <ol {...cmsListe('etkinlikler:ozel.adimlar.liste')}>
          {e.ozel.adimlar.liste.map((a, i) => (
            <li data-cms-oge={i}><b {...cms(`etkinlikler:ozel.adimlar.liste.${i}.baslik`)}>{a.baslik}</b><span {...cms(`etkinlikler:ozel.adimlar.liste.${i}.metin`)}>{a.metin}</span></li>
          ))}
        </ol>
        <div class="btns"><RezButon sinif="btn-dark" etiket="WhatsApp'tan planla" tur="ozel-gun" mesaj="Merhaba, Müjgân'da özel bir gün için yer ayırtmak istiyorum. Ne kutluyoruz: … Tarih: … Kişi sayısı: …" /></div>
      </div>
    </div>
  </section>
</Base>
