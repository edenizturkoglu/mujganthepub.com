---
import Base from '../layouts/Base.astro';
import Gorsel from '../components/Gorsel.astro';
import Ikon from '../components/Ikon.astro';
import Bekliyor from '../components/Bekliyor.astro';
import { isletme, rezervasyon } from '../data/isletme';
import { menu, izgaraSirasi, enDusuk, fiyatYaz } from '../data/menu';
import { geceler } from '../data/program';
import { ana, cms, cmsListe } from '../lib/icerik';
import { isletmeSema, siteSema, sssSema } from '../lib/sema';

const rez = rezervasyon();
const harita = isletme.haritaLinki;
const izgara = izgaraSirasi.map((id) => [menu.findIndex((k) => k.id === id), menu.find((k) => k.id === id)] as const).filter(([, k]) => k);
const paketVar = isletme.siparisPlatformlari.length > 0 || !isletme.yayinda;
const h = ana.hero;
---
<Base yol="/" sayfa="ana" onYukle={h.gorsel.src} sema={[isletmeSema(), siteSema(), sssSema()]}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media"><Gorsel g={h.gorsel} cms="ana:hero.gorsel" oncelik /></div>
    <div class="wrap">
      <div class="hero-copy">
        <h1 id="hero-title"><span class="h1-eyebrow" {...cms('ana:hero.ust')}>{h.ust}</span><span {...cms('ana:hero.baslik')}>{h.baslik}</span> <em {...cms('ana:hero.vurgu')}>{h.vurgu}</em></h1>
        <p class="lead" {...cms('ana:hero.metin')}>{h.metin}</p>
        <div class="btns">
          <a class="btn btn-gold" href="/menu/" data-olay="menu_goruntule"><Ikon ad="menu" /><span {...cms('ana:hero.buton1')}>{h.buton1}</span></a>
          <a class="btn btn-line" href={harita} target="_blank" rel="noopener" data-olay="yol_tarifi_tikla"><Ikon ad="pin" /><span {...cms('ana:hero.buton2')}>{h.buton2}</span></a>
        </div>
      </div>
      <aside class="tonight" id="tonight" aria-live="polite" data-cms-panel="etkinlikler">
        <p class="label"><span>Bugün</span><span data-t="day">Her gün</span></p>
        <h3 data-t="title">Social Hour</h3>
        <span class="time num" data-t="time">Hafta içi 18.00'e kadar</span>
        <p data-t="text">Tüm içeceklerde %20 indirim.</p>
        <p class="open num">Açığız: {isletme.saatler.acik}</p>
        <a class="link-arrow" href="/etkinlikler/">Tüm etkinlikler →</a>
      </aside>
    </div>
  </section>

  <div class="marquee" aria-hidden="true" {...cmsListe('ana:serit')}>
    <div class="marquee-track">{[...ana.serit, ...ana.serit].map((s, i) => <span {...(i < ana.serit.length ? { ...cms(`ana:serit.${i}`), 'data-cms-oge': i } : {})}>{s}</span>)}</div>
  </div>

  <section class="sec" aria-labelledby="gun-title">
    <div class="wrap">
      <div class="sec-head"><p class="label" {...cms('ana:gun.ust')}>{ana.gun.ust}</p><h2 id="gun-title" {...cms('ana:gun.baslik')}>{ana.gun.baslik}</h2></div>
      <div class="split">
        {(['ogle', 'aksam'] as const).map((k) => {
          const t = ana.gun[k];
          return (
            <a class="tile" href={t.link} data-cms-link={`ana:gun.${k}.link`}>
              <Gorsel g={t.gorsel} cms={`ana:gun.${k}.gorsel`} />
              <div class="tile-body"><p class="label" {...cms(`ana:gun.${k}.ust`)}>{t.ust}</p><h3 {...cms(`ana:gun.${k}.baslik`, 'html')} set:html={t.baslik} /><p {...cms(`ana:gun.${k}.metin`)}>{t.metin}</p></div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0" aria-labelledby="ritim-title">
    <div class="wrap">
      <div class="sec-head-row">
        <div class="sec-head"><p class="label" {...cms('ana:ritim.ust')}>{ana.ritim.ust}</p><h2 id="ritim-title" {...cms('ana:ritim.baslik')}>{ana.ritim.baslik}</h2></div>
        <a class="link-arrow" href="/etkinlikler/" {...cms('ana:ritim.link')}>{ana.ritim.link}</a>
      </div>
      <div class="posters" data-cms-panel="etkinlikler">
        {geceler.map((g, i) => (
          <a class="poster" href={`/etkinlikler/#${g.id}`} data-dow={g.gun}>
            <div class="poster-img"><Gorsel g={g.afis} cms={`etkinlikler:geceler.${i}.afis`} /></div>
            <div class="day"><b>{g.kisa}</b><span>{g.saat}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0" aria-labelledby="mutfak-title">
    <div class="wrap">
      <div class="sec-head-row">
        <div class="sec-head"><p class="label" {...cms('ana:mutfak.ust')}>{ana.mutfak.ust}</p><h2 id="mutfak-title" {...cms('ana:mutfak.baslik')}>{ana.mutfak.baslik}</h2></div>
        <a class="link-arrow" href="/menu/" data-olay="menu_goruntule" {...cms('ana:mutfak.link')}>{ana.mutfak.link}</a>
      </div>
      <div class="bento" data-cms-panel="menu">
        {izgara.map(([i, k]) => (
          <a class={k!.izgara.boyut === 'genis' ? 'b-wide' : k!.izgara.boyut === 'uzun' ? 'b-tall' : undefined} href={`/menu/#${k!.id}`}>
            <Gorsel g={k!.izgara} cms={`menu:kategoriler.${i}.izgara`} />
            <span>{k!.baslik}<small class="num">{fiyatYaz(enDusuk(k!))}₺'den</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec bar-band" aria-labelledby="bar-title">
    <div class="wrap bar-grid">
      <div class="bar-copy">
        <p class="label" {...cms('ana:bar.ust')}>{ana.bar.ust}</p>
        <h2 id="bar-title" {...cms('ana:bar.baslik', 'html')} set:html={ana.bar.baslik} />
        <p {...cms('ana:bar.metin')}>{ana.bar.metin}</p>
        <div class="btns"><a class="btn btn-line" href={ana.bar.buton.link} {...cms('ana:bar.buton', 'link')}>{ana.bar.buton.metin}</a></div>
      </div>
      <div class="glasses">
        {ana.bar.gorseller.map((g, i) => <figure><Gorsel g={g} cms={`ana:bar.gorseller.${i}`} /></figure>)}
      </div>
    </div>
  </section>

  <section class="sec" id="paket" aria-label="Paket servis ve grup rezervasyonu">
    <div class={paketVar ? 'wrap duo' : 'wrap'}>
      {paketVar && <div class="panel panel-kraft">
        <p class="label" {...cms('ana:paket.ust')}>{ana.paket.ust}</p>
        <h2 {...cms('ana:paket.baslik')}>{ana.paket.baslik}</h2>
        <p {...cms('ana:paket.metin')}>{ana.paket.metin}</p>
        <div class="btns">
          {isletme.siparisPlatformlari.map((o) => (
            <a class="btn btn-dark" href={o.url} target="_blank" rel="noopener" data-olay="siparis_platform_tikla" data-platform={o.ad}><Ikon ad="bag" />{o.ad}</a>
          ))}
          {!isletme.siparisPlatformlari.length && <Bekliyor ne="paket servis platform linkleri" />}
        </div>
      </div>}
      <div class="panel panel-line">
        <p class="label" {...cms('ana:grup.ust')}>{ana.grup.ust}</p>
        <h2 {...cms('ana:grup.baslik')}>{ana.grup.baslik}</h2>
        <p {...cms('ana:grup.metin')}>{ana.grup.metin}</p>
        <div class="btns"><a class="btn btn-gold" href={rez.url} target="_blank" rel="noopener" data-olay="rezervasyon_tikla" data-platform={rez.kanal}><Ikon ad="chat" />{rez.etiket}</a></div>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0" aria-labelledby="ig-title">
    <div class="wrap">
      <div class="sec-head-row">
        <div class="sec-head"><p class="label">@{isletme.instagram.kullanici}</p><h2 id="ig-title" {...cms('ana:instagram.baslik')}>{ana.instagram.baslik}</h2></div>
        <a class="link-arrow" href={isletme.instagram.url} target="_blank" rel="noopener" data-olay="instagram_tikla" {...cms('ana:instagram.link')}>{ana.instagram.link}</a>
      </div>
      <div class="grid6">
        {ana.instagram.gorseller.map((g, i) => <a href={isletme.instagram.url} target="_blank" rel="noopener" aria-label="Instagram'da Müjgân" data-olay="instagram_tikla"><Gorsel g={g} cms={`ana:instagram.gorseller.${i}`} /></a>)}
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0" aria-labelledby="sss-title">
    <div class="wrap">
      <div class="sec-head"><p class="label" {...cms('ana:sss.ust')}>{ana.sss.ust}</p><h2 id="sss-title" {...cms('ana:sss.baslik')}>{ana.sss.baslik}</h2></div>
      <div class="faq" {...cmsListe('ana:sss.sorular')}>
        {ana.sss.sorular.map((q, i) => (
          <details open={i === 0} data-cms-oge={i}><summary {...cms(`ana:sss.sorular.${i}.soru`)}>{q.soru}</summary><p {...cms(`ana:sss.sorular.${i}.cevap`)}>{q.cevap}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="ulasim" style="padding-top:0" aria-labelledby="ulasim-title">
    <div class="wrap visit-grid">
      <div class="visit-photo"><Gorsel g={ana.ulasim.gorsel} cms="ana:ulasim.gorsel" /></div>
      <div class="visit-copy" data-cms-panel="isletme">
        <p class="label" id="ulasim-title" {...cms('ana:ulasim.ust')}>{ana.ulasim.ust}</p>
        <address>{isletme.adres.satirlar.map((s, i) => <>{i > 0 && <br />}<span {...cms(`isletme:adres.satirlar.${i}`)}>{s}</span></>)}</address>
        <p {...cms('ana:ulasim.metin')}>{ana.ulasim.metin}</p>
        {isletme.girisTarifi ? <p {...cms('isletme:girisTarifi')}>{isletme.girisTarifi}</p> : <p><Bekliyor ne="AVM içinde giriş tarifi" /></p>}
        <div class="btns"><a class="btn btn-gold" href={harita} target="_blank" rel="noopener" data-olay="yol_tarifi_tikla"><Ikon ad="pin" /><span {...cms('ana:ulasim.buton')}>{ana.ulasim.buton}</span></a></div>
        <div class="facts">
          <div><span>Açık</span><strong class="num">Her gün <span {...cms('isletme:saatler.acik')}>{isletme.saatler.acik}</span></strong></div>
          <div><span>Mutfak</span><strong {...cms('isletme:saatler.mutfak')}>{isletme.saatler.mutfak}</strong></div>
          {isletme.telefon && <div><span>Telefon</span><a class="num" href={`tel:${isletme.telefon.replace(/\s/g, '')}`} data-olay="telefon_tikla" {...cms('isletme:telefon')}>{isletme.telefon}</a></div>}
          <div><span>Rezervasyon</span><a href={rez.url} target="_blank" rel="noopener" data-olay="rezervasyon_tikla" data-platform={rez.kanal}>{rez.etiket}</a></div>
          <div><span>Instagram</span><a href={isletme.instagram.url} target="_blank" rel="noopener" data-olay="instagram_tikla">@{isletme.instagram.kullanici}</a></div>
        </div>
      </div>
    </div>
  </section>
</Base>
